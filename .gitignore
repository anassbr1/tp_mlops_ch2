__pycache__/
*.py[cod]
*$py.class
*.pyo

# ─── Jupyter Notebooks (checkpoints) ─────────────────────────────────────────
.ipynb_checkpoints/

# ─── OS et IDE ───────────────────────────────────────────────────────────────
